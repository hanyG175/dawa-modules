# Copy to .env for local development. Never commit the copied file.

# Google Drive OAuth files. Store the files under an ignored credentials/ directory.
GOOGLE_OCR_CREDENTIALS_DIR=credentials
GOOGLE_OCR_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_OCR_TOKEN_FILE=drive-python-quickstart.json

# Optional Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
