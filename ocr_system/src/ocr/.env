# Copy this file to src/ocr/.env and update values if needed
# Tesseract executable path
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Tesseract data directory (required for French/Arabic)
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# OCR languages for Tesseract (eng, fra, ara...)
# Format can be eng+fra or eng,fra or ara+fra
# Make sure training data files exist in TESSDATA_PREFIX (e.g., fra.traineddata, ara.traineddata)
OCR_LANGUAGES=ara+fra
