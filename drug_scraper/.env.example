# Environment Configuration
# Copy this file to .env and fill in your values

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log

# Scraping Configuration
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Data Storage
DATA_PATH=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# Database (Optional)
DATABASE_URL=sqlite:///./drug_data.db
# DATABASE_URL=postgresql://user:password@localhost/drug_db

# API Keys (if required by any source)
DRUGBANK_API_KEY=
CHEMBL_API_KEY=

# Proxy (if needed)
USE_PROXY=False
PROXY_URL=

# Cache Settings
USE_CACHE=True
CACHE_EXPIRY=86400

# Rate Limiting
REQUESTS_PER_SECOND=1
RESPECT_ROBOTS_TXT=True
